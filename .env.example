# ============================================================
# ROBO NFS-e ADN - ON4 CONTABILIDADE
# Salvar sempre em UTF-8 (os caminhos tem acento). Nao versionar.
# ============================================================

# ---------------- API do ADN ----------------
ADN_URL_BASE=https://adn.nfse.gov.br/contribuintes
AMBIENTE_ESPERADO=PRODUCAO
ADN_PARAM_CNPJ=cnpjConsulta

# ---------------- Saida na rede ----------------
# ZIPs de notas emitidas
RAIZ_EMITIDAS=<<AJUSTE>>/Fiscal/Importação
# ZIPs de notas recebidas (tomados)
RAIZ_RECEBIDAS=<<AJUSTE>>/Fiscal/Importação - Tomados
# Planilhas de conferencia por empresa
RAIZ_RELATORIOS=<<AJUSTE>>/Fiscal/Relatorios Conferencia ISS
# Certificados A1: uma pasta so, arquivos nomeados na planilha
CERTIFICADOS_DIR=<<AJUSTE>>/Certificados

# Planilha mensal consolidada DESTE robo. Tem de ser um arquivo SO DELE:
# a PLANILHA RELATORIO MENSAL.xlsx (sem o sufixo) e do robo do ISS Digital.
PLANILHA_MENSAL=<<AJUSTE>>/Fiscal/Relatorios Conferencia ISS/PLANILHA RELATORIO MENSAL (API).xlsx

# ---------------- Pastas locais (fora do OneDrive) ----------------
# O OneDrive trava o arquivo no meio da escrita e corrompe o SQLite, o que
# perderia o ponteiro de NSU de todas as empresas de uma vez.
STAGING_DIR=C:/RoboNFSe/staging
LOGS_DIR=C:/RoboNFSe/logs
DB_PATH=C:/RoboNFSe/data/nfse_adn.db

# ---------------- Dentro da pasta do robo ----------------
RELATORIOS_DIR=./relatorios
CLIENTES_CSV=./data/clientes.csv
MUNICIPIOS_CSV=./data/municipios.csv

# ---------------- Comportamento HTTP ----------------
TIMEOUT_CONNECT=30
TIMEOUT_READ=120
# Sem pausa a API cortou com HTTP 429 no NSU 51; com 1s foram 61 paginas limpas.
INTERVALO_REQUISICOES=1
MAX_TENTATIVAS=5

# Pausa entre EMPRESAS, em segundos. O ADN derruba o handshake mTLS
# (RECORD_LAYER_FAILURE) quando recebe conexoes seguidas demais do mesmo IP.
# Sem pausa, 79% da carteira falhou na rodada de 25/08/2026.
INTERVALO_EMPRESAS=3

# ---------------- Senha dos certificados ----------------
# A coluna `senha_certificado` do clientes.csv pode ficar VAZIA. Quando ela
# estiver vazia, o robo usa a senha abaixo. E o caminho recomendado: o CSV
# vira um cadastro sem segredo nenhum dentro, e a senha fica so aqui — num
# arquivo que o .gitignore mantem fora do repositorio.
# Preencher a coluna continua funcionando, para o caso de uma empresa ter
# senha propria; a coluna tem prioridade sobre esta variavel.
SENHA_CERTIFICADO_PADRAO=
